# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/

# --- Entornos virtuales ---
.venv/
venv/
env/
ENV/

# --- Variables de entorno / secretos ---
.env
*.env.local

# --- SWI-Prolog compilado ---
*.qlf

# --- Reportes/artefactos generados en tiempo de ejecucion (no versionar) ---
/output/
/generated_reports/
*.log
src/backend/instance/
# Flask resuelve la carpeta instance/ en la raiz del repo cuando la app se
# ejecuta con `python src/backend/app.py` (como indica el README), en vez de
# dentro de src/backend/; se ignora en ambas ubicaciones posibles.
/instance/

# --- Herramientas y cache ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# --- Sistema operativo / editor ---
